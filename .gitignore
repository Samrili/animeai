# ==============================================================================
# AnimeAI - Git Ignore Configuration
# ==============================================================================

# AI Models (Downloaded automatically via kurulum.bat / download_models.py)
ComfyUI/models/**/*.safetensors
ComfyUI/models/**/*.ckpt
ComfyUI/models/**/*.pth
ComfyUI/models/**/*.pt
ComfyUI/models/**/*.bin
ComfyUI/models/**/*.onnx
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.onnx

# Exceptions for small gitkeep files
!.gitkeep

# User generation outputs
output/*
!output/.gitkeep
ComfyUI/output/*
!ComfyUI/output/.gitkeep

# User uploaded inputs and caches
ComfyUI/input/*
!ComfyUI/input/.gitkeep
ComfyUI/temp/*
!ComfyUI/temp/.gitkeep

# Logs and runtime caches
*.log
*.log.*
*.prev.log
*.prev2.log
ComfyUI/user/*.log
ComfyUI/user/*.log.*
ComfyUI/user/__manager/cache/

# Databases, state, and runtime locks
*.db
*.db-shm
*.db-wal
*.db.lock
ComfyUI/user/*.db
ComfyUI/user/*.db.lock
ComfyUI/user/*.db-shm
ComfyUI/user/*.db-wal
ComfyUI/user/was-node-suite/*.db*

# Scratch and backup workspaces
scratch/
backups/
*.backup
*.backup*
*.bak
yapılacaklar.txt
poster_tool.html
ComfyUI/user/default/workflows/Unsaved*
assets/samples/test_*.png

# Internal test, debug, and one-off patch scripts (keep repo clean for end users)
scripts/test_*.py
scripts/inspect_*.py
scripts/check_*.py
scripts/diagnose_*.py
scripts/patch_*.py
scripts/analyze_*.py
scripts/apply_*.py
scripts/clean_workflow.py
scripts/download_remaining.py
scripts/fast_download.py
scripts/generate_creative_styles.py
scripts/generate_diversity_showcase.py
scripts/generate_extra_styles.py
scripts/generate_poster_workflow.py
scripts/generate_style_comparisons.py
scripts/generate_techniques_data.py
scripts/optimize_anatomy.py
scripts/rebuild_all_poster_workflows.py
scripts/ref_workflow.json
scripts/trace_workflow.py
scripts/update_*.py
scripts/validate_workflow.py
scripts/build_anime_workflow.py

# Temporary downloads and partial files
*.tmp
*.part

# Python cache and byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
venv/
env/
ENV/
.env

# IDE and OS metadata
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
